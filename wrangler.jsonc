{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calendarfactory",
  "main": "src/index.js",
  "compatibility_date": "2026-03-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "BANNERS_BUCKET",
      "bucket_name": "calendarfactory-banners"
    }
  ]
}
